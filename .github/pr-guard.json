{
  "schema": "pr-guard/v1",
  "a38": {
    "enforce": ["develop"],
    "exclude": ["main"],
    "default": "enforce"
  },
  "workflow_approval": {
    "enabled": true,
    "workflows": [".github/workflows/ci.yml"]
  },
  "lifecycle": {
    "enabled": true,
    "auto_ready": true,
    "required_workflows": [".github/workflows/ci.yml"],
    "ignored_workflows": [".github/workflows/a38-guard.yml"],
    "required_checks": {
      ".github/workflows/ci.yml": [
        "Typecheck",
        "Test (100% coverage)",
        "e2e"
      ]
    }
  }
}
